{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Company Brain test question pack (T14)",
  "type": "object",
  "required": ["split", "seed", "questions"],
  "additionalProperties": false,
  "properties": {
    "split": {"enum": ["all", "tuning", "locked"]},
    "seed": {"type": "integer"},
    "questions": {"type": "array", "items": {"$ref": "#/$defs/question"}}
  },
  "$defs": {
    "question": {
      "type": "object",
      "required": [
        "id", "language", "client", "category", "mode", "question",
        "expected_answer", "required_facts", "required_sources"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^q-(en|es)-[0-9]{2}$"},
        "language": {"enum": ["en", "es"]},
        "client": {"type": "string", "minLength": 1},
        "category": {
          "enum": ["fact", "table_chart", "multi_document", "summary", "unanswerable", "adversarial"]
        },
        "mode": {"enum": ["answer", "summarise"]},
        "question": {"type": "string", "minLength": 10},
        "expected_answer": {"type": "string", "minLength": 2},
        "required_facts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "required_sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "location"],
            "additionalProperties": false,
            "properties": {
              "file": {"type": "string", "minLength": 1},
              "location": {"type": "object"}
            }
          }
        },
        "must_not_contain": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
